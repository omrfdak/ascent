<?xml version="1.0" encoding="UTF-8"?>
<!--
    What the app tells iOS about itself. Felgo's build points at this file by
    name, so it is written by hand rather than generated, and the $(...) values
    are filled in from the project by Xcode.

    Deliberately short. The template this started from declares a reason for the
    camera, the microphone, the photo library, contacts, Bluetooth and location;
    this game asks for none of them, and a permission string for a permission
    that is never requested is a question at review time with no answer behind
    it.

    Portrait only, because the scene is portrait and the balloon rises. Landscape
    would letterbox the game down to a strip in the middle of the screen and give
    the player nothing for it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Ascent</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(PRODUCT_VERSION_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(PRODUCT_VERSION_CODE)</string>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>Launch Screen</string>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
</dict>
</plist>
