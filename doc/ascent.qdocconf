project     = Ascent
description = "Ascent - building a provably fair crash game with Felgo"
version     = 1.0.0

outputdir     = html
outputformats = HTML

# Prose lives in .qdoc files next to this config. Code is never pasted into them:
# \snippet pulls it out of the real sources, which is why the project root is an
# example dir. A sample in the tutorial is therefore always a sample that compiles.
sourcedirs  = .
exampledirs = ..
imagedirs   = images

sourcefile.extensions = *.qdoc

# This is a tutorial, not an API reference, so there is no module header to parse.
moduleheader =

navigation.homepage = "Ascent"

# qdoc writes no styling of its own. The stylesheet is copied into html/style/
# and linked from every page; the viewport line goes in the same block because
# it is the only other thing these pages need in their head.
HTML.stylesheets = style/ascent.css

HTML.headerstyles = \
    "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" \
    "  <link rel=\"stylesheet\" type=\"text/css\" href=\"style/ascent.css\">\n"

# A broken link or an unresolved snippet fails the run instead of scrolling past.
warninglimit         = 0
warninglimit.enabled = true
